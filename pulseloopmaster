# pulsecompressionpulseloop.py
# ----------------------------
# A generic pulse-compression / pulse-loop engine that you can
# plug into ZCMS + HSN outputs (or any scalar time-series).

from __future__ import annotations
from dataclasses import dataclass
from typing import List, Callable, Protocol
import math
import random


class PulseTransform(Protocol):
    def __call__(self, value: float, t: int, total_steps: int) -> float:
        ...


@dataclass
class PulseCompressionConfig:
    steps: int = 256
    base_amplitude: float = 1.0
    compression_factor: float = 0.85
    noise_level: float = 0.0
    feedback_gain: float = 0.3
    clamp_min: float = -1.0
    clamp_max: float = 1.0
    seed: int | None = None


class PulseCompressionPulseLoop:
    """
    PulseCompressionPulseLoop
    -------------------------
    - Generates a base pulse
    - Iteratively compresses it
    - Applies optional transforms
    - Feeds back previous state into the next

    Usage:
        cfg = PulseCompressionConfig(steps=512, compression_factor=0.9)
        loop = PulseCompressionPulseLoop(cfg)
        data = loop.run()
    """

    def __init__(
        self,
        config: PulseCompressionConfig | None = None,
        transforms: List[PulseTransform] | None = None,
    ):
        self.config = config or PulseCompressionConfig()
        self.transforms = transforms or []
        if self.config.seed is not None:
            random.seed(self.config.seed)

    # ---------- core helpers ----------

    def _base_pulse(self, t: int) -> float:
        """
        Base pulse shape.
        You can swap this for any analytic pulse:
        - Gaussian
        - Sinc
        - Exponential decay
        - etc.
        """
        steps = self.config.steps
        center = steps / 2.0
        width = steps / 8.0
        x = (t - center) / width
        return self.config.base_amplitude * math.exp(-0.5 * x * x)

    def _compress(self, value: float) -> float:
        """
        Simple non-linear compression:
            y = sign(x) * |x|^c
        where c in (0,1) compresses dynamic range.
        """
        c = self.config.compression_factor
        if c <= 0:
            return value
        sign = 1.0 if value >= 0 else -1.0
        mag = abs(value)
        return sign * (mag ** c)

    def _add_noise(self, value: float) -> float:
        if self.config.noise_level <= 0:
            return value
        return value + random.uniform(
            -self.config.noise_level, self.config.noise_level
        )

    def _clamp(self, value: float) -> float:
        return max(self.config.clamp_min, min(self.config.clamp_max, value))

    # ---------- main loop ----------

    def run(self) -> List[float]:
        """
        Run the pulse compression loop and return the full time-series.
        """
        steps = self.config.steps
        feedback = 0.0
        series: List[float] = []

        for t in range(steps):
            # 1. base pulse
            v = self._base_pulse(t)

            # 2. add feedback from previous step
            v += self.config.feedback_gain * feedback

            # 3. compress
            v = self._compress(v)

            # 4. optional transforms (e.g. ZCMS / HSN modulation)
            for transform in self.transforms:
                v = transform(v, t, steps)

            # 5. noise + clamp
            v = self._add_noise(v)
            v = self._clamp(v)

            # 6. store + update feedback
            series.append(v)
            feedback = v

        return series


# ---------- example transforms ----------

def hsn_modulation_transform(
    heidegger_weight: float,
    spinoza_weight: float,
    nietzsche_weight: float,
) -> PulseTransform:
    """
    Example: modulate the pulse by a simple H-S-N phase blend.
    """

    def _transform(value: float, t: int, total_steps: int) -> float:
        phase = 2.0 * math.pi * t / max(1, total_steps - 1)
        h = heidegger_weight * math.cos(phase)
        s = spinoza_weight * math.sin(phase)
        n = nietzsche_weight * math.cos(2 * phase)
        factor = 1.0 + 0.25 * (h + s + n)
        return value * factor

    return _transform


